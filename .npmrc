ignore-scripts=true
audit=true
# pnpm 11 enforces a minimum-release-age on lockfile entries as a supply-chain
# mitigation. Set to 7d — packages younger than a week cannot land in the
# lockfile. Tightens the default 24h window. Day-old typo-squat / hijack
# attempts will be more likely caught by the registry before they reach this
# project.
minimum-release-age=7d
